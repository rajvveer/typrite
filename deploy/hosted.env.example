# Copy to .env.hosted (ignored by Git). Replace EVERY placeholder before deployment.
# Use Neon console's .NET/Npgsql format, not a postgresql:// URI.
DATABASE_CONNECTION_STRING='Host=YOUR-ENDPOINT-pooler.REGION.aws.neon.tech;Database=neondb;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=VerifyFull;Maximum Pool Size=20;Timeout=30'
PUBLIC_API_URL=https://typrite.example.com
DEVICE_SIGNING_KEY=
OIDC_AUTHORITY=https://YOUR_IDENTITY_PROVIDER
OIDC_AUDIENCE=YOUR_API_AUDIENCE
OIDC_CLIENT_ID=YOUR_PUBLIC_SPA_CLIENT_ID
OIDC_SCOPES='openid profile YOUR_API_SCOPE'
# Compose accepts single-quoted multiline values. Supply a complete RSA private PEM;
# keep its matching public key pinned in the Windows agent configuration.
RELEASE_PRIVATE_KEY_PEM='REPLACE_WITH_YOUR_COMPLETE_RSA_PRIVATE_KEY_PEM'
