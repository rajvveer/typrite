<Project Sdk="Microsoft.NET.Sdk.Worker">
  <!-- Device agent: holds the device key, enrolls, heartbeats, polls commands, checks releases, brokers tokens to the desktop over a named pipe.
       Runs as a Windows Service in production; runs as a console host elsewhere for development. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>typrite-agent</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Typrite.Contracts/Typrite.Contracts.csproj" />
    <ProjectReference Include="../Typrite.Domain/Typrite.Domain.csproj" />
  </ItemGroup>
</Project>
