<UserControl
  x:Class="Typrite.Desktop.AdRegion"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.Resources>
      <Storyboard x:Name="CampaignMotion" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetName="ProductScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.06" Duration="0:0:12" />
        <DoubleAnimation Storyboard.TargetName="ProductScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.06" Duration="0:0:12" />
      </Storyboard>
      <Storyboard x:Name="CampaignProgress" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetName="ProgressScale" Storyboard.TargetProperty="ScaleX" From="0" To="1" Duration="0:0:8" />
      </Storyboard>
      <Storyboard x:Name="HeadlineReveal">
        <DoubleAnimation Storyboard.TargetName="CampaignCopy" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.45" />
        <DoubleAnimation Storyboard.TargetName="CopyShift" Storyboard.TargetProperty="Y" From="5" To="0" Duration="0:0:0.45" />
      </Storyboard>
    </Grid.Resources>
    <Border x:Name="MockCampaign" CornerRadius="16" Visibility="Collapsed" Background="#160D19" SizeChanged="OnCampaignSizeChanged">
      <Grid>
        <Image x:Name="CampaignProduct" Source="Assets/mock-headphones-v1.png" Stretch="Uniform" HorizontalAlignment="Right" RenderTransformOrigin="0.75,0.5" AutomationProperties.Name="FORM One concept headphones">
          <Image.RenderTransform><ScaleTransform x:Name="ProductScale" /></Image.RenderTransform>
        </Image>
        <Border x:Name="ProductFade" Width="120" HorizontalAlignment="Right"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#160D19" Offset="0" /><GradientStop Color="#00160D19" Offset="1" /></LinearGradientBrush></Border.Background></Border>
        <Grid Padding="22,12,18,12" RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="FORM" FontSize="12" FontWeight="Bold" CharacterSpacing="190" Foreground="#FFF4EC" />
              <TextBlock Text="/ ONE" FontSize="10" CharacterSpacing="100" Foreground="#CFB2AD" VerticalAlignment="Center" />
            </StackPanel>
            <Border Grid.Column="1" Background="#B020171A" BorderBrush="#50E7C4AE" BorderThickness="1" CornerRadius="4" Padding="5,2">
              <TextBlock Text="DEMO AD" FontSize="8" FontWeight="SemiBold" CharacterSpacing="90" Foreground="#F6E3D6" />
            </Border>
          </Grid>
          <StackPanel x:Name="CampaignCopy" Grid.Row="1" VerticalAlignment="Center" Spacing="3" HorizontalAlignment="Left">
            <StackPanel.RenderTransform><TranslateTransform x:Name="CopyShift" /></StackPanel.RenderTransform>
            <TextBlock x:Name="CampaignHeadline" Text="Less noise.&#x0a;More you." FontSize="29" FontWeight="SemiBold" LineHeight="31" LineStackingStrategy="BlockLineHeight" Foreground="#FFF7EF" />
            <TextBlock x:Name="CampaignSubtitle" Visibility="Collapsed" Text="Wireless sound. Effortless style." FontSize="10" Foreground="#D6BCBC" />
          </StackPanel>
          <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
            <Button x:Name="CampaignAction" Padding="10,5" CornerRadius="6" BorderThickness="0" Background="#F1E6DC" Foreground="#281B25" FontSize="10" FontWeight="SemiBold" AutomationProperties.Name="Explore FORM One demo campaign">
              <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="Explore FORM One" /><TextBlock Text="↗" /></StackPanel>
              <Button.Flyout>
                <Flyout Placement="Top" ShouldConstrainToRootBounds="False">
                  <StackPanel Width="330" Spacing="12">
                    <Image Source="Assets/mock-headphones-v1.png" Height="132" Stretch="UniformToFill" />
                    <TextBlock Text="FORM One" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Find your frequency." FontSize="16" />
                    <TextBlock Text="A concept wireless headphone campaign, designed for the everyday soundtrack." TextWrapping="Wrap" Foreground="#A9ADB5" />
                    <TextBlock Text="Mock advertisement · fictional product" FontSize="11" Foreground="#BFB395" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <TextBlock x:Name="CampaignFrame" Grid.Column="1" Text="01 / 03" Foreground="#E1C8BE" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>
        </Grid>
        <Border Height="2" Background="#44362C31" VerticalAlignment="Bottom">
          <Rectangle Fill="#F0C5AA" RenderTransformOrigin="0,0.5">
            <Rectangle.RenderTransform><ScaleTransform x:Name="ProgressScale" ScaleX="0" /></Rectangle.RenderTransform>
          </Rectangle>
        </Border>
      </Grid>
    </Border>
    <Image x:Name="Still" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Advertisement image" />
    <MediaPlayerElement x:Name="Video" Stretch="Uniform" AreTransportControlsEnabled="False" AutoPlay="False"
                        Visibility="Collapsed" AutomationProperties.Name="Advertisement video" />
    <Border x:Name="SponsorBadge" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,3" CornerRadius="4" Background="#BB0D1119">
      <TextBlock Text="SPONSORED" FontSize="9" FontWeight="SemiBold" CharacterSpacing="100" Foreground="White" />
    </Border>
  </Grid>
</UserControl>
