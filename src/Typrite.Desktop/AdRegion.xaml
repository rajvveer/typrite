<UserControl
  x:Class="Typrite.Desktop.AdRegion"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Width="400" Height="225">
  <Grid CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
    <Image x:Name="Still" Stretch="Uniform" Visibility="Collapsed" AutomationProperties.Name="Advertisement image" />
    <MediaPlayerElement x:Name="Video" Stretch="Uniform" AreTransportControlsEnabled="False" AutoPlay="False"
                        Visibility="Collapsed" AutomationProperties.Name="Advertisement video" />
    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2" CornerRadius="2"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
      <TextBlock Text="Advertisement" Style="{StaticResource CaptionTextBlockStyle}" />
    </Border>
  </Grid>
</UserControl>
