<Window
  x:Class="Typrite.Desktop.BarWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:Typrite.Desktop">
  <Grid x:Name="MainSurface" RequestedTheme="Dark" Background="#101214" RowDefinitions="Auto,*" SizeChanged="OnLayoutSizeChanged">
    <Grid.Resources>
      <SolidColorBrush x:Key="MutedText" Color="#8D949C" />
      <SolidColorBrush x:Key="TimeAccent" Color="#BCD5FF" />
      <SolidColorBrush x:Key="TimeMuted" Color="#91A7CA" />
      <SolidColorBrush x:Key="TimeOutline" Color="#2B4165" />
      <LinearGradientBrush x:Key="TimeGradient" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1B2E50" Offset="0" /><GradientStop Color="#111D34" Offset="1" /></LinearGradientBrush>
      <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
      </Style>
    </Grid.Resources>
    <Border x:Name="TaskbarSlot" />
    <Grid x:Name="ContentGrid" Grid.Row="1" ColumnSpacing="12" Padding="14,10,14,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ClockColumn" Width="202" />
        <ColumnDefinition x:Name="WeatherColumn" Width="340" />
        <ColumnDefinition x:Name="ForecastColumn" Width="*" />
        <ColumnDefinition x:Name="AdColumn" Width="500" />
      </Grid.ColumnDefinitions>
      <Grid Padding="12,9,6,7" RowDefinitions="Auto,*,Auto">
        <TextBlock x:Name="DateText" FontSize="11" CharacterSpacing="130" FontWeight="SemiBold" Foreground="#A2AAA7" AutomationProperties.Name="Current date" />
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="0">
          <TextBlock AutomationProperties.Name="Current time" Margin="-3,0,0,0">
            <Run x:Name="ClockText" FontFamily="Bahnschrift" FontSize="56" FontWeight="Light" />
            <Run x:Name="MeridiemText" FontSize="12" Foreground="#A2AAA7" />
          </TextBlock>
          <TextBlock x:Name="GreetingText" FontSize="11" Foreground="#8D949C" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
          <Ellipse Width="5" Height="5" Fill="{StaticResource TimeAccent}" VerticalAlignment="Center" />
          <TextBlock Text="LOCAL DESKTOP" FontSize="9" CharacterSpacing="170" Foreground="#A3ABA2" />
        </StackPanel>
      </Grid>

      <Border x:Name="WeatherCard" Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="17" BorderBrush="{StaticResource TimeOutline}" BorderThickness="1" Padding="17,8,17,10" Background="{StaticResource TimeGradient}">
        <Grid x:Name="WeatherCurrentGrid" Width="290" HorizontalAlignment="Left" RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <Button x:Name="CityButton" Style="{StaticResource QuietButton}" Padding="0,5" HorizontalAlignment="Left" ToolTipService.ToolTip="Choose weather location">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE707;" FontSize="11" Foreground="{StaticResource TimeAccent}" />
                <TextBlock x:Name="LocationText" Text="Finding your city…" FontSize="12" FontWeight="SemiBold" MaxWidth="230" TextTrimming="CharacterEllipsis" />
                <FontIcon Glyph="&#xE70D;" FontSize="7" Foreground="#9EBAA7" />
              </StackPanel>
              <Button.Flyout>
                <Flyout x:Name="CityFlyout" Placement="Top" ShouldConstrainToRootBounds="False">
                  <StackPanel Width="300" Spacing="10">
                    <TextBlock Text="Weather location" FontSize="18" FontWeight="SemiBold" />
                    <Button Content="Use this PC's location" Click="UseAutomaticLocation" HorizontalAlignment="Stretch" />
                    <TextBlock Text="Or choose a city" Foreground="{StaticResource MutedText}" FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox x:Name="CitySearch" PlaceholderText="City, country" AutomationProperties.Name="Search weather city" />
                      <Button x:Name="CitySearchButton" Grid.Column="1" Content="Find" Click="SearchWeatherCity" />
                    </Grid>
                    <TextBlock x:Name="CitySearchStatus" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" />
                    <ListView x:Name="CityResults" MaxHeight="180" DisplayMemberPath="Label" IsItemClickEnabled="True" ItemClick="ChooseWeatherCity" SelectionMode="None" />
                  </StackPanel>
                </Flyout>
              </Button.Flyout>
            </Button>
            <Button x:Name="WeatherRefreshButton" Grid.Column="1" Style="{StaticResource QuietButton}" Width="28" Height="28" Padding="0"
                    Click="RefreshWeatherClicked" AutomationProperties.Name="Refresh weather" ToolTipService.ToolTip="Refresh weather">
              <FontIcon Glyph="&#xE72C;" FontSize="11" Foreground="{StaticResource TimeMuted}" />
            </Button>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
              <TextBlock x:Name="TemperatureText" Text="—" FontSize="60" FontWeight="SemiLight" Foreground="#F1F6FF" />
              <TextBlock Text="°" FontSize="29" Foreground="{StaticResource TimeAccent}" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5" Margin="18,0,12,0">
              <TextBlock x:Name="WeatherText" Text="Local weather" FontSize="16" FontWeight="SemiBold" Foreground="#EBF2FF" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="FeelsLikeText" Text="Updating…" FontSize="12" Foreground="{StaticResource TimeMuted}" />
              <TextBlock x:Name="HighLowText" FontSize="12" Foreground="{StaticResource TimeMuted}" />
            </StackPanel>
            <Grid Grid.Column="2" Width="74" Height="70" VerticalAlignment="Center">
              <TextBlock x:Name="WeatherGlyph" Visibility="Collapsed" />
              <Canvas x:Name="NightArt" Width="72" Height="70">
                <Path Data="M 42,5 C 13,5 6,42 28,57 C 43,68 62,61 69,47 C 39,54 25,24 42,5 Z" Fill="{StaticResource TimeAccent}" />
                <Path Data="M 56,8 L 58,13 L 63,15 L 58,17 L 56,22 L 54,17 L 49,15 L 54,13 Z" Fill="{StaticResource TimeAccent}" />
                <Ellipse Canvas.Left="67" Canvas.Top="28" Width="3" Height="3" Fill="{StaticResource TimeAccent}" />
              </Canvas>
              <Canvas x:Name="SunArt" Width="72" Height="70" Visibility="Collapsed">
                <Ellipse Canvas.Left="12" Canvas.Top="12" Width="48" Height="48" Fill="#F0D993" />
                <Ellipse Canvas.Left="4" Canvas.Top="4" Width="64" Height="64" Stroke="#66D4C283" StrokeThickness="1" />
              </Canvas>
              <Canvas x:Name="CloudArt" Width="72" Height="70" Visibility="Collapsed">
                <Path Data="M 15,53 C 0,53 0,31 16,30 C 17,8 48,7 53,28 C 76,24 82,54 60,55 Z" Fill="#D1E2D6" />
                <Path x:Name="RainArt" Data="M 22,59 L 18,67 M 38,59 L 34,67 M 54,59 L 50,67" Stroke="#99C6D0" StrokeThickness="3" Visibility="Collapsed" />
              </Canvas>
            </Grid>
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="0,8,0,0" BorderBrush="{StaticResource TimeOutline}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="18"><TextBlock x:Name="WindText" Text="Wind —" FontSize="11" Foreground="{StaticResource TimeMuted}" /><TextBlock x:Name="HumidityText" Text="Humidity —" FontSize="11" Foreground="{StaticResource TimeMuted}" /></StackPanel>
            <TextBlock x:Name="WeatherUpdatedText" Grid.Column="1" Text="Open-Meteo" FontSize="10" Foreground="{StaticResource TimeAccent}" />
          </Grid>
        </Grid>
      </Border>

      <Border x:Name="ForecastCard" Grid.Column="2" Padding="12,13,16,12" SizeChanged="OnForecastSizeChanged">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="ForecastPeriodText" Text="TONIGHT" FontSize="10" FontWeight="SemiBold" CharacterSpacing="130" Foreground="{StaticResource TimeMuted}" />
            <TextBlock x:Name="ForecastTrendText" Grid.Column="1" Text="Next 4 hours" FontSize="10" Foreground="{StaticResource TimeAccent}" />
          </Grid>
          <ItemsControl x:Name="HourlyForecast" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#2645638B" BorderThickness="1,0,0,0">
                  <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#9DB5D8" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Symbol}" FontFamily="Segoe UI Symbol" FontSize="25" Foreground="#C2DAFF" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Temperature}" FontSize="21" FontWeight="SemiBold" Foreground="#E8EFF9" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ForecastEmptyText" Grid.Row="1" Text="Forecast is on its way…" FontSize="11" Foreground="{StaticResource TimeMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <TextBlock Grid.Row="2" Text="HOURLY OUTLOOK" FontSize="8" CharacterSpacing="160" Foreground="{StaticResource TimeMuted}" HorizontalAlignment="Center" />
        </Grid>
      </Border>
      <Border x:Name="AdCard" Grid.Column="3" CornerRadius="17" BorderBrush="#4C3C41" BorderThickness="1" Background="#20151D">
        <local:AdRegion x:Name="Ad" />
      </Border>
    </Grid>
  </Grid>
</Window>
