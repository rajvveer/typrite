<Window
  x:Class="Typrite.Desktop.BarWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0" ColumnSpacing="24"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
      <TextBlock x:Name="ClockText" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.Name="Current time" />
      <TextBlock x:Name="DateText" Style="{StaticResource CaptionTextBlockStyle}" AutomationProperties.Name="Current date" />
    </StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2">
      <TextBlock x:Name="WeatherText" Text="Weather unavailable" Style="{StaticResource BodyStrongTextBlockStyle}" />
      <TextBlock x:Name="LocationText" Text="Location unavailable" Style="{StaticResource CaptionTextBlockStyle}" />
    </StackPanel>
    <Border Grid.Column="2" Width="400" Height="225" VerticalAlignment="Center" CornerRadius="4"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
        <TextBlock Text="Advertisement" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Center" />
        <TextBlock Text="House creative placeholder" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
