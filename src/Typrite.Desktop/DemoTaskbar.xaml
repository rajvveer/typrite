<UserControl
  x:Class="Typrite.Desktop.DemoTaskbar"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Height="48" Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,1">
    <Grid ColumnDefinitions="*,Auto,*" Padding="12,0">
      <TextBlock x:Name="StatusText" Text="Demo · unlocked" VerticalAlignment="Center"
                 MaxWidth="180" TextTrimming="CharacterEllipsis"
                 Style="{StaticResource CaptionTextBlockStyle}"
                 AutomationProperties.LiveSetting="Polite" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Start" ToolTipService.ToolTip="Start" AccessKey="S">
          <Grid Width="20" Height="20" RowDefinitions="*,*" ColumnDefinitions="*,*" RowSpacing="2" ColumnSpacing="2">
            <Rectangle Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Column="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Row="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
            <Rectangle Grid.Row="1" Grid.Column="1" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
          </Grid>
          <Button.Flyout>
            <Flyout Placement="Top">
              <StackPanel Width="280" Spacing="12" Padding="12">
                <TextBlock Text="Pinned" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Microsoft Edge" Tag="microsoft-edge:" Click="LaunchApp" HorizontalAlignment="Stretch" />
                <Button Content="File Explorer" Tag="explorer.exe" Click="LaunchApp" HorizontalAlignment="Stretch" />
                <Button Content="Notepad" Tag="notepad.exe" Click="LaunchApp" HorizontalAlignment="Stretch" />
                <Button Content="Calculator" Tag="calculator:" Click="LaunchApp" HorizontalAlignment="Stretch" />
                <Button Content="Settings" Tag="ms-settings:" Click="LaunchApp" HorizontalAlignment="Stretch" />
                <TextBlock Text="Demo mode — Windows restrictions are not applied."
                           TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                <Button Content="Exit demo" Click="ExitDemo" HorizontalAlignment="Stretch" />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0"
                AutomationProperties.Name="Running apps" ToolTipService.ToolTip="Running apps">
          <FontIcon Glyph="&#xE7F4;" FontSize="20" />
          <Button.Flyout>
            <MenuFlyout x:Name="RunningApps" Opening="RefreshRunningApps" Placement="Top" />
          </Button.Flyout>
        </Button>
        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Tag="explorer.exe"
                Click="LaunchApp" AutomationProperties.Name="File Explorer" ToolTipService.ToolTip="File Explorer">
          <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Button>
        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Tag="microsoft-edge:"
                Click="LaunchApp" AutomationProperties.Name="Microsoft Edge" ToolTipService.ToolTip="Microsoft Edge">
          <FontIcon Glyph="&#xE774;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
        <Button Width="44" Height="44" Background="Transparent" BorderThickness="0" Tag="ms-settings:"
                Click="LaunchApp" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings">
          <FontIcon Glyph="&#xE713;" FontSize="18" />
        </Button>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TimeText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
          <TextBlock x:Name="DateText" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
